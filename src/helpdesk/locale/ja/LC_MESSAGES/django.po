#: templates/helpdesk/emails/assigned_follower_subject.txt
#, python-format
msgid "(Assigned) Ticket %(ticket_id)s - %(ticket_title)s"
msgstr "(割り当て済み) チケット %(ticket_id)s - %(ticket_title)s"

#: templates/helpdesk/emails/closed_follower_subject.txt
#, python-format
msgid "(Closed) Ticket %(ticket_id)s - %(ticket_title)s"

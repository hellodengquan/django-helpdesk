msgstr "以下のコメントが追加されました："

#: templates/helpdesk/emails/updated_follower.txt
msgid "This information has not been e-mailed to the submitter."
msgstr "この情報は提出者にメール送信されていません。"

#: templates/helpdesk/emails/updated_follower.txt
msgid "This information has been e-mailed to the submitter."
msgstr "この情報は提出者にメール送信されました。"

#: templates/helpdesk/emails/assigned_follower.html
msgid "Ticket Assigned - Followed Ticket"
